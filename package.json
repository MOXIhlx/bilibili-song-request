{
  "name": "bilibili-song-request",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "description": "本地弹幕点歌机：B站直播弹幕点歌 + mpv 播放 + OBS 浏览器源面板",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-versions.mjs && vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "test": "node --test tests/*.test.ts",
    "check:versions": "node scripts/check-versions.mjs",
    "fix:versions": "node scripts/check-versions.mjs --fix",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "fetch:mpv": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-mpv.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@types/node": "^22.10.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
